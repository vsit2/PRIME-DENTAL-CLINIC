# ==============================================================================
# PRIME DENTAL CLINIC - Environment Variables Configuration
# Copy this file to .env for local overrides, or set these in Render / Railway / Docker
# ==============================================================================

# Database Connection (Individual Parameters)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prime_dental_db
DB_USER=root
DB_PASS=

# Alternatively, Cloud Database Connection URL (e.g. from TiDB Cloud / Aiven / Railway)
# DATABASE_URL=mysql://root:password@localhost:3306/prime_dental_db
# MYSQL_URL=mysql://root:password@localhost:3306/prime_dental_db

# Web Server Port (Render / Cloud platforms set this automatically)
# PORT=80
